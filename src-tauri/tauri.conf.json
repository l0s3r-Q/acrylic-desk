{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AcrylicDesk",
  "version": "0.1.0",
  "identifier": "com.acrylicdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "title": "AcrylicDesk",
        "url": "index.html?view=panel",
        "width": 320,
        "height": 720,
        "minWidth": 120,
        "minHeight": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": true,
        "center": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active",
          "radius": 12
        }
      },
      {
        "label": "settings",
        "title": "AcrylicDesk 设置",
        "url": "index.html?view=settings",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": false,
        "windowEffects": {
          "effects": ["mica"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "resources": [],
    "copyright": "Copyright © 2026 AcrylicDesk",
    "category": "Utility",
    "shortDescription": "亚克力桌面管理面板",
    "longDescription": "将桌面图标收纳进贴靠屏幕边缘的亚克力透明面板，鼠标碰边即唤出。"
  }
}

